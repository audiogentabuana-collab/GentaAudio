{
  "name": "gentabuana",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "hash-password": "node scripts/hash-password.mjs",
    "gen-secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\"",
    "gas:push": "cd apps-script && npx -y @google/clasp@3.4.1 push",
    "gas:login": "npx -y @google/clasp@3.4.1 login",
    "gas:deployments": "cd apps-script && npx -y @google/clasp@3.4.1 list-deployments",
    "gas:redeploy": "cd apps-script && npx -y @google/clasp@3.4.1 create-deployment -i"
  },
  "dependencies": {
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
