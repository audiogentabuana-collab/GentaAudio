# =============================================================
# Genta Buana — variabel environment Next.js
# Salin ke .env.local (lokal) dan isi juga di Vercel > Settings > Environment Variables.
# JANGAN commit file .env asli.
# =============================================================

# URL Web App Apps Script (Deploy > Manage deployments > Web app URL, berakhiran /exec)
GAS_WEB_APP_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Harus SAMA PERSIS dengan Script Property API_KEY di Apps Script (min. 32 karakter)
GAS_API_KEY=

# Rahasia untuk menandatangani cookie sesi admin (min. 32 karakter).
# Buat dengan: npm run gen-secret
SESSION_SECRET=

# URL publik website (tanpa garis miring di akhir). Dipakai untuk SEO, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://gentabuana.vercel.app

# Interval revalidasi cache halaman publik (detik). Perubahan dari admin tetap langsung tampil.
REVALIDATE_SECONDS=3600

# true = matikan Image Optimization Vercel (hemat kuota). Default false.
NEXT_IMAGE_UNOPTIMIZED=false

# Timeout panggilan ke Apps Script (milidetik)
GAS_TIMEOUT_MS=15000

# --- Khusus pengembangan lokal ---
# true = pakai Apps Script tiruan (in-memory + file .mock-gas/) tanpa akun Google.
# Tidak bisa aktif di Vercel.
GAS_MOCK=false
# Login admin di mode mock
MOCK_ADMIN_USERNAME=admin
MOCK_ADMIN_PASSWORD=admin12345
